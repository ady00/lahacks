[
  {"id": "IRS-meal", "layer": "irs", "text": "Business meals outside company-wide events are 50% deductible.",
   "cite": "IRC §274(n)(1); Pub. 463 ch. 2", "url": "https://www.law.cornell.edu/uscode/text/26/274",
   "when": {"and": [{"eq": ["expense_kind", "meal"]}, {"not": "at_company_event"}]}, "require": {"and": [{"eq": ["coded_account", "meals_50"]}, {"eq": ["deductible", "50%"]}]}},
  {"id": "IRS-meal-event", "layer": "irs", "text": "Meals at company-wide recreational events for employees are 100% deductible.",
   "cite": "IRC §274(e)(4), §274(n)(2)(A)", "url": "https://www.law.cornell.edu/uscode/text/26/274",
   "when": {"and": [{"eq": ["expense_kind", "meal"]}, "at_company_event"]}, "require": {"and": [{"eq": ["coded_account", "meals_100"]}, {"eq": ["deductible", "100%"]}]}},
  {"id": "IRS-ent", "layer": "irs", "text": "Entertainment (tickets, games, shows, golf, clubs) is not deductible since the 2017 Tax Cuts and Jobs Act.",
   "cite": "IRC §274(a)(1); Reg. §1.274-11", "url": "https://www.law.cornell.edu/cfr/text/26/1.274-11",
   "when": {"eq": ["expense_kind", "entertainment"]}, "require": {"and": [{"eq": ["coded_account", "entertainment_0"]}, {"eq": ["deductible", "0%"]}]}},
  {"id": "IRS-travel", "layer": "irs", "text": "Flights, trains, rental cars, lodging, rides, parking and mileage are travel.",
   "cite": "IRC §162(a)(2); Pub. 463 ch. 1", "url": "https://www.irs.gov/publications/p463",
   "when": {"in": ["expense_kind", ["airfare", "train", "car_rental", "lodging", "rideshare", "parking", "mileage", "fuel", "dry_cleaning", "visa"]]}, "require": {"eq": ["coded_account", "travel"]}},
  {"id": "IRS-office", "layer": "irs", "text": "Equipment, supplies, software, internet, phone, co-working and shipping are office expenses.",
   "cite": "IRC §162(a); Pub. 334 ch. 8", "url": "https://www.irs.gov/publications/p334",
   "when": {"in": ["expense_kind", ["equipment", "laptop", "personal_device", "office_supplies", "software", "internet", "phone", "coworking", "shipping", "business_cards"]]}, "require": {"eq": ["coded_account", "office"]}},
  {"id": "IRS-other", "layer": "irs", "text": "Books, development, gifts, swag and anything else are coded other.",
   "cite": "IRC §162(a)", "url": "https://www.law.cornell.edu/uscode/text/26/162",
   "when": {"in": ["expense_kind", ["books", "development", "gift", "swag", "other"]]}, "require": {"eq": ["coded_account", "other"]}},
  {"id": "IRS-receipt-60", "layer": "irs", "text": "Under an accountable plan, expenses must be substantiated within 60 days (the safe harbor).",
   "cite": "Reg. §1.62-2(g)(2)(i)", "url": "https://www.law.cornell.edu/cfr/text/26/1.62-2",
   "when": {"gt": ["days_since_purchase", 60]}, "require": "receipt_attached"},
  {"id": "IRS-receipt-75", "layer": "irs", "text": "Expenses of $75 or more need documentary evidence (a receipt).",
   "cite": "Reg. §1.274-5(c)(2)(iii)(B)", "url": "https://www.law.cornell.edu/cfr/text/26/1.274-5",
   "when": {"and": [{"ge": ["amount", 75]}, {"gt": ["days_since_purchase", 0]}]}, "require": "receipt_attached"},
  {"id": "IRS-lodging-receipt", "layer": "irs", "text": "Lodging away from home needs a receipt at any amount.",
   "cite": "Reg. §1.274-5(c)(2)(iii)(A)", "url": "https://www.law.cornell.edu/cfr/text/26/1.274-5",
   "when": {"and": [{"eq": ["expense_kind", "lodging"]}, {"gt": ["days_since_purchase", 0]}]}, "require": "receipt_attached"},
  {"id": "IRS-companion", "layer": "irs", "text": "Travel for a spouse, partner or family member is not deductible; only the employee's own share is.",
   "cite": "IRC §274(m)(3)", "url": "https://www.law.cornell.edu/uscode/text/26/274",
   "when": {"and": [{"in": ["expense_kind", ["airfare", "train", "car_rental", "lodging"]]}, "companion_present"]}, "require": {"eq": ["deductible", "limited"]}},
  {"id": "IRS-commute", "layer": "irs", "text": "Commuting between home and the regular workplace is a personal expense and cannot be reimbursed under an accountable plan.",
   "cite": "IRC §262(a); Reg. §1.262-1(b)(5); Rev. Rul. 99-7", "url": "https://www.irs.gov/pub/irs-drop/rr-99-7.pdf",
   "when": {"and": [{"in": ["expense_kind", ["rideshare", "parking", "mileage"]]}, "commuting"]}, "require": false},
  {"id": "IRS-mileage", "layer": "irs", "text": "Mileage is reimbursable tax-free up to the 2026 standard rate of 72.5 cents a mile; anything above it is wages.",
   "cite": "Notice 2026-10; Reg. §1.62-2(c)(4)", "url": "https://www.irs.gov/tax-professionals/standard-mileage-rates",
   "when": {"eq": ["expense_kind", "mileage"]}, "require": {"le": [{"per": ["amount", "miles"]}, 0.725]}},
  {"id": "IRS-gift-25", "layer": "irs", "text": "Business gifts are deductible up to $25 per recipient per year; the rest is not.",
   "cite": "IRC §274(b)(1)", "url": "https://www.law.cornell.edu/uscode/text/26/274",
   "when": {"and": [{"eq": ["expense_kind", "gift"]}, {"gt": [{"per": ["amount", "attendees"]}, 25]}]}, "require": {"eq": ["deductible", "limited"]}}
]
