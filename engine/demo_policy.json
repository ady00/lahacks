[
  {"id": "3.4", "layer": "company", "text": "Any expense over $35 needs manager pre-approval.",
   "when": {"gt": ["amount", 35]}, "require": "pre_approved"},
  {"id": "3.5", "layer": "company", "text": "Any expense over $500 needs a receipt attached.",
   "when": {"gt": ["amount", 500]}, "require": "receipt_attached"},
  {"id": "4.1", "layer": "company", "text": "Receipts for expenses over $25 are due within 14 days.",
   "when": {"and": [{"gt": ["amount", 25]}, {"gt": ["days_since_purchase", 14]}]}, "require": "receipt_attached"},
  {"id": "5.1", "layer": "company", "text": "Contractors are not reimbursed for meals.",
   "when": {"and": [{"eq": ["role", "contractor"]}, {"eq": ["expense_kind", "meal"]}]}, "require": false},
  {"id": "5.2", "layer": "company", "text": "Interns get no transport reimbursement except at company events.",
   "when": {"and": [{"eq": ["role", "intern"]}, {"in": ["expense_kind", ["rideshare", "airfare"]]}]}, "require": "at_company_event"},
  {"id": "5.3", "layer": "company", "text": "Interns may expense meals only at company events.",
   "when": {"and": [{"eq": ["role", "intern"]}, {"eq": ["expense_kind", "meal"]}]}, "require": "at_company_event"},
  {"id": "6.1", "layer": "company", "text": "Meals after 10pm need pre-approval.",
   "when": {"and": [{"eq": ["expense_kind", "meal"]}, {"ge": ["hour", 22]}]}, "require": "pre_approved"},
  {"id": "6.2", "layer": "company", "text": "Meals before 6am need pre-approval.",
   "when": {"and": [{"eq": ["expense_kind", "meal"]}, {"lt": ["hour", 6]}]}, "require": "pre_approved"},
  {"id": "6.3", "layer": "company", "text": "Entertainment always needs pre-approval.",
   "when": {"eq": ["expense_kind", "entertainment"]}, "require": "pre_approved"},
  {"id": "6.4", "layer": "company", "text": "Entertainment over $100 is never reimbursed.",
   "when": {"and": [{"eq": ["expense_kind", "entertainment"]}, {"gt": ["amount", 100]}]}, "require": false},
  {"id": "6.5", "layer": "company", "text": "Client meals over $150 need pre-approval even with a client present.",
   "when": {"and": [{"eq": ["expense_kind", "meal"]}, {"eq": ["client_present", true]}, {"gt": ["amount", 150]}]}, "require": "pre_approved"},
  {"id": "7.1", "layer": "company", "text": "Airfare always needs pre-approval.",
   "when": {"eq": ["expense_kind", "airfare"]}, "require": "pre_approved"},
  {"id": "7.2", "layer": "company", "text": "Hotels over $300 a night need pre-approval.",
   "when": {"and": [{"eq": ["expense_kind", "hotel"]}, {"gt": ["amount", 300]}]}, "require": "pre_approved"},
  {"id": "8.1", "layer": "company", "text": "Software needs IT pre-approval at any price.",
   "when": {"eq": ["expense_kind", "software"]}, "require": "pre_approved"},
  {"id": "8.2", "layer": "company", "text": "Equipment over $250 needs pre-approval and a receipt.",
   "when": {"and": [{"eq": ["expense_kind", "equipment"]}, {"gt": ["amount", 250]}]}, "require": {"and": ["pre_approved", "receipt_attached"]}},
  {"id": "9.1", "layer": "company", "text": "Rideshare over $75 needs pre-approval.",
   "when": {"and": [{"eq": ["expense_kind", "rideshare"]}, {"gt": ["amount", 75]}]}, "require": "pre_approved"}
]
